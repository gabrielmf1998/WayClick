# Maintainer: gabrielmf1998 <noreply@github.com>
pkgname=wayclick
pkgver=1.4.0
pkgrel=1
pkgdesc="Autoclicker for Wayland, using /dev/uinput"
arch=('any')
url="https://github.com/gabrielmf1998/WayClick"
license=('MIT')
depends=('python>=3.9' 'pyside6')
install=wayclick.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
  cd "$srcdir/WayClick-$pkgver"

  install -Dm755 wayclick.py "$pkgdir/usr/share/wayclick/wayclick.py"
  install -d "$pkgdir/usr/bin"
  cat > "$pkgdir/usr/bin/wayclick" <<'LAUNCH'
#!/usr/bin/env bash
exec python3 /usr/share/wayclick/wayclick.py "$@"
LAUNCH
  chmod 755 "$pkgdir/usr/bin/wayclick"

  install -Dm644 packaging/wayclick.desktop \
    "$pkgdir/usr/share/applications/wayclick.desktop"
  install -Dm644 packaging/wayclick.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/wayclick.svg"
  install -Dm644 packaging/99-wayclick-uinput.rules \
    "$pkgdir/usr/lib/udev/rules.d/99-wayclick-uinput.rules"
  install -Dm644 packaging/uinput.conf \
    "$pkgdir/usr/lib/modules-load.d/wayclick-uinput.conf"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 README.pt-BR.md "$pkgdir/usr/share/doc/$pkgname/README.pt-BR.md"
}
